# =============================================================================
# Forecast VM - configuration (sourced by sync.sh and run-forecast.sh)
#
# Copy to  ~/.config/forecast-vm/forecast.env   (chmod 600)
# NO passwords or tokens in this file. SMB credentials live in
# /etc/forecast-vm/smb.cred (root:root, 600); an optional Claude token in a
# separate 600 file that OAUTH_TOKEN_FILE points to. Nothing of that is in git.
# Plain bash syntax; $HOME is expanded.
# =============================================================================

# --- where the packs come from -----------------------------------------------
# rsync    : cifs mount of the Unraid share + local mirror (sync.sh, README option 2)
# virtiofs : the share is mapped into the VM, no sync (README option 1)
# local    : test copy only, never touches the share (README step 'Testlauf')
PACK_MODE=rsync

# context_packs folder of the share AS SEEN FROM THE VM
#   rsync    : cifs mount point + AlpacaBroker/context_packs
#   virtiofs : virtiofs mount point + context_packs (source path
#              /mnt/user/Workfiles/AlpacaBroker) - or + AlpacaBroker/context_packs
#              if Unraid only accepts the top-level share /mnt/user/Workfiles
SHARE_PACK_DIR=/mnt/unraid-workfiles/AlpacaBroker/context_packs
#SHARE_PACK_DIR=/mnt/alpaca/context_packs

# local mirror (rsync) or test copy (local)
LOCAL_PACK_ROOT=$HOME/alpaca/context_packs

# --- code and working directories ---------------------------------------------
REPO_DIR=$HOME/alpaca/repo          # git clone (sparse: .claude/skills, docs, infra/forecast-vm)
WORK_DIR=$HOME/alpaca/workdir       # EMPTY directory: claude starts here, so the repo's CLAUDE.md is not loaded
STATE_DIR=$HOME/alpaca/state        # locks and attempt counters - keep on the VM's local disk
LOG_DIR=$HOME/alpaca/logs

# --- the forecaster (changing MODEL or the skill version restarts the sample!) --
# Sebastian decides. FULL model id, no alias: forecaster_version becomes
# swp-vN+<MODEL>+pack2 and must stay identical every day (docs/FORECASTS.md section 6).
MODEL=claude-opus-5-5

# Optional pins - run-forecast.sh refuses to run when the checked-out skill differs.
# Set after a deliberate update ("git pull" must not change the forecaster unnoticed).
EXPECT_SKILL_VERSION=swp-v2
#EXPECT_SKILL_COMMIT=<output of: git -C $REPO_DIR log -1 --format=%H -- .claude/skills/signal-warehouse-prognose>

# --- limits ---------------------------------------------------------------------
MAX_BUDGET_USD=12          # claude --max-budget-usd (client-side estimate; tune with total_cost_usd of the first runs)
MAX_TURNS=300              # claude --max-turns
RUN_TIMEOUT_MIN=150        # hard stop of one run
MIN_MINUTES_BEFORE_SEAL=45 # do not start when the last seal (09:25 New York) is closer than this
MAX_ATTEMPTS=2             # claude launches per pack (07:30, 09:30, 11:30 timers share this budget)

# --- authentication (optional) ----------------------------------------------------
# Default: interactive login once ('claude', then /login) - stored in ~/.claude/.credentials.json.
# If the login ever expires unnoticed: 'claude setup-token' prints a one-year token;
# store it ALONE in a file (chmod 600) and point to it here.
#OAUTH_TOKEN_FILE=$HOME/.config/forecast-vm/claude.token

# --- sync -----------------------------------------------------------------------
#PULL_LAST_N=6
#PUSH_LAST_N=6
